# Copy to .env (git-ignored) and fill in. The key stays on the server and is never sent to the browser.
GEMINI_API_KEY=
# Optional
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# PORT=5173
# HOST=127.0.0.1
# ALLOWED_ORIGINS=https://dwind-source.github.io
# TRUST_PROXY=1
# GitHub Pages builds read the public backend URL from repository variable WAVEGUARD_API_URL.
# VITE_API_BASE_URL is a public URL only, never an API key.
